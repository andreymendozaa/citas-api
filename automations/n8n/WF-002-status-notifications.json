    {
      "parameters": {
        "jsCode": "// Rejected payload: record only which field failed.\nconst error = $input.first().json.error;\n$execution.customData.set('result', 'invalid');\n$execution.customData.set('invalidField', String(error));\nreturn [{ json: { result: 'invalid', error } }];"
      },
      "id": "b2a0f002-0000-4000-8000-000000000006",
      "name": "Registrar invalido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 440]
    },
    {
      "parameters": {
        "jsCode": "// Deduplicate by eventId (citas-api retries once with the same eventId). Keeps 7 days of ids in static data,\n// which persists only for production (active) executions.\nconst store = $getWorkflowStaticData('global');\nstore.events = store.events || {};\nconst cutoff = Date.now() - 7 * 24 * 3600 * 1000;\nfor (const [id, ts] of Object.entries(store.events)) if (ts < cutoff) delete store.events[id];\nreturn $input.all().map((item) => {\n  const duplicate = Boolean(store.events[item.json.eventId]);\n  if (!duplicate) store.events[item.json.eventId] = Date.now();\n  $execution.customData.set('eventId', item.json.eventId);\n  $execution.customData.set('appointmentId', String(item.json.appointmentId));\n  $execution.customData.set('notificationType', item.json.notificationType);\n  return { json: { ...item.json, duplicate } };\n});"
      },

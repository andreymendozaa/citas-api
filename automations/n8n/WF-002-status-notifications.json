    {
      "parameters": {
        "jsCode": "// Validate the citas-api event contract (schemaVersion 1.0) and classify it. Extra fields are ignored; nothing is echoed back.\nconst UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nconst allowed = {\n  'appointment.status.changed': { ADMIN: ['APPROVED', 'REJECTED'], USER: ['CANCELLED'] },\n  'appointment.reschedule.decided': { ADMIN: ['APPROVED', 'REJECTED'] }\n};\nconst positiveInt = (v) => Number.isInteger(v) && v > 0;\nreturn $input.all().map((item) => {\n  const b = item.json.body || {};\n  const fail = (field) => ({ json: { valid: false, error: field } });\n  if (b.schemaVersion !== '1.0') return fail('schemaVersion');\n  if (!UUID.test(String(b.eventId || ''))) return fail('eventId');\n  const rules = allowed[b.eventType];\n  if (!rules) return fail('eventType');\n  if (!positiveInt(b.appointmentId)) return fail('appointmentId');\n  if (!(rules[b.source] || []).includes(b.status)) return fail('status/source');\n  const reschedule = b.eventType === 'appointment.reschedule.decided';\n  if (reschedule && !positiveInt(b.rescheduleRequestId)) return fail('rescheduleRequestId');\n  const at = DateTime.fromISO(String(b.occurredAt || ''), { zone: 'utc' });\n  if (!at.isValid) return fail('occurredAt');\n  const notificationType = reschedule\n    ? (b.status === 'APPROVED' ? 'RESCHEDULE_APPROVED' : 'RESCHEDULE_REJECTED')\n    : (b.status === 'CANCELLED' ? 'CANCELLATION' : (b.status === 'APPROVED' ? 'SPECIALIZED_APPROVED' : 'SPECIALIZED_REJECTED'));\n  return { json: {\n    valid: true,\n    eventId: b.eventId,\n    eventType: b.eventType,\n    appointmentId: b.appointmentId,\n    rescheduleRequestId: reschedule ? b.rescheduleRequestId : null,\n    status: b.status,\n    source: b.source,\n    notificationType,\n    occurredLocal: at.setZone('America/Bogota').setLocale('es').toFormat(\"d 'de' LLLL 'de' yyyy, HH:mm\")\n  } };\n});"
      },
      "id": "b2a0f002-0000-4000-8000-000000000002",
      "name": "Validar payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {

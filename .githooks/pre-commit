#!/usr/bin/env sh
set -eu

git diff --cached --name-only --diff-filter=ACM | while IFS= read -r file; do
  case "$file" in .env.example|.githooks/pre-commit) continue ;; esac
  if git show ":$file" | grep -Eiq '(JWT_(ACCESS|REFRESH)_SECRET|DB_PASSWORD|MYSQL_ROOT_PASSWORD|OAUTH_CLIENT_SECRET)[[:space:]]*[:=][[:space:]]*[^[:space:]$]+'; then
    printf '%s\n' "Se detectó un secreto potencial en $file. Retíralo antes de confirmar."
    exit 1
  fi
done

if [ -n "${DB_HOST:-}" ] && [ -n "${DB_NAME:-}" ] && [ -n "${DB_USER:-}" ] && [ -n "${DB_PASSWORD:-}" ]; then
  TEST_DB_URL="jdbc:mysql://${DB_HOST}:${DB_PORT:-3306}/${DB_NAME}" TEST_DB_USER="$DB_USER" TEST_DB_PASSWORD="$DB_PASSWORD" mvn test
else
  mvn test
fi
